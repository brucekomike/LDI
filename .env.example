# Copy to .env (ignored by Git) and fill in the private wiki connection.
# MW_SERVER is the base URL, not the /api.php URL.
MW_SERVER=https://wiki.example.org
MW_ARTICLE_PATH=/wiki
MW_SCRIPT_PATH=/w

# Dedicated least-privilege MediaWiki BotPassword for the MCP server.
MW_USER=WikiBot@WikiBotPassword
MW_PASS=replace-with-botpassword

# Optional: exact private wiki hostname if its server URL resolves to a
# private/loopback address and the MCP server's SSRF guard rejects it.
MCP_TRUSTED_HOSTS=

# Docker bridge address for this Linux host. Use the host's Docker bridge
# gateway if it differs from 172.17.0.1.
MW_MCP_BIND=172.17.0.1
MW_MCP_PORT=18080
