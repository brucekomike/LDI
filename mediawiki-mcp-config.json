{
  "allowWikiManagement": false,
  "defaultWiki": "dev-wiki",
  "wikis": {
    "dev-wiki": {
      "sitename": "Development Wiki",
      "server": "${MW_SERVER}",
      "articlepath": "${MW_ARTICLE_PATH}",
